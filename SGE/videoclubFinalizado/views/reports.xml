<odoo>
    <!--Informe 1 Basico-->
    <record id="action_report_alquiler" model="ir.actions.report">
      <field name="name">Informe de Alquiler</field>
      <field name="model">videoclub.alquiler</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">videoclub.report_alquiler_template</field>
      <field name="report_file">videoclub.report_alquiler_template</field>
      <field name="binding_model_id" ref="model_videoclub_alquiler"/>
      <field name="binding_type">report</field>
    </record>

    <template id="report_alquiler_template">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="web.external_layout">
            <div class="page">
              <h2>Resguardo de Alquiler</h2>
              <hr/>
              <p><strong>Cliente:</strong> <t t-esc="doc.cliente_id.name"/></p>
              <p><strong>Email:</strong> <t t-esc="doc.cliente_email"/></p>
              <p><strong>Película:</strong> <t t-esc="doc.pelicula_id.name"/></p>
              <p><strong>Fecha alquiler:</strong> <t t-esc="doc.fecha_alquiler"/></p>
              <p><strong>Fecha devolución:</strong> <t t-esc="doc.fecha_devolucion"/></p>
              <p><strong>Días alquilado:</strong> <t t-esc="doc.dias_alquiler"/></p>
              <p><strong>Estado:</strong> <t t-esc="doc.estado"/></p>
            </div>
          </t>
        </t>
      </t>
    </template>

    <!--Informe 2 con foto-->
    <record id="action_report_pelicula" model="ir.actions.report">
      <field name="name">Ficha de Película</field>
      <field name="model">videoclub.pelicula</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">videoclub.report_pelicula_template</field>
      <field name="report_file">videoclub.report_pelicula_template</field>
      <field name="binding_model_id" ref="model_videoclub_pelicula"/>
      <field name="binding_type">report</field>
    </record>

    <template id="report_pelicula_template">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="web.external_layout">
            <div class="page">
              <div style="display: flex; gap: 24px; align-items: flex-start;">
                <!-- Foto -->
                <div>
                  <img t-if="doc.imagen"
                       t-att-src="image_data_uri(doc.imagen)"
                       style="width: 150px; height: 200px; object-fit: cover; border-radius: 8px;"/>
                  <div t-else=""
                       style="width:150px; height:200px; background:#eee;
                              display:flex; align-items:center; justify-content:center;
                              border-radius:8px; color:#999;">
                    Sin imagen
                  </div>
                </div>
                <!-- Datos -->
                <div>
                  <h2 style="margin-top:0"><t t-esc="doc.name"/></h2>
                  <p><strong>Categoría:</strong> <t t-esc="doc.categoria_id.name"/></p>
                  <p><strong>Año:</strong> <t t-esc="doc.anio"/></p>
                  <p><strong>Duración:</strong> <t t-esc="doc.duracion"/> min</p>
                  <p><strong>Disponible:</strong>
                    <t t-if="doc.disponible">Sí</t>
                    <t t-else="">No</t>
                  </p>
                  <p><strong>Actores:</strong>
                    <t t-foreach="doc.actor_ids" t-as="actor">
                      <t t-esc="actor.name"/><t t-if="not actor_last">, </t>
                    </t>
                  </p>
                  <p><strong>Descripción:</strong><br/>
                    <t t-esc="doc.descripcion"/>
                  </p>
                </div>
              </div>
            </div>
          </t>
        </t>
      </t>
    </template>

    <!--Informe 3 vistoso-->

    <record id="action_report_catalogo" model="ir.actions.report">
      <field name="name">Catálogo Videoclub</field>
      <field name="model">videoclub.pelicula</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">videoclub.report_catalogo_template</field>
      <field name="report_file">videoclub.report_catalogo_template</field>
      <field name="binding_model_id" ref="model_videoclub_pelicula"/>
    </record>
  
    <template id="report_catalogo_template">
      <t t-call="web.html_container">
        <t t-call="web.external_layout">
          <div class="page">

            <!-- Título -->
            <h2>Catálogo de Películas</h2>
            <p>Videoclub</p>
            <hr/>

            <!-- Tabla simple -->
            <table class="table table-sm" style="width:100%; border-collapse: collapse;">
              <thead>
                <tr style="border-bottom:1px solid #000;">
                  <th>Título</th>
                  <th>Categoría</th>
                  <th>Año</th>
                  <th>Duración</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="docs" t-as="doc">
                  <tr>
                    <td><t t-esc="doc.name"/></td>
                    <td><t t-esc="doc.categoria_id.name"/></td>
                    <td><t t-esc="doc.anio"/></td>
                    <td><t t-esc="doc.duracion"/> min</td>
                    <td>
                      <t t-if="doc.disponible">Disponible</t>
                      <t t-else="">Alquilada</t>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>

            <!-- Resumen -->
            <p style="margin-top:20px;">
              Total: <strong><t t-esc="len(docs)"/></strong> |
              Disponibles: <strong><t t-esc="len(docs.filtered(lambda p: p.disponible))"/></strong> |
              Alquiladas: <strong><t t-esc="len(docs.filtered(lambda p: not p.disponible))"/></strong>
            </p>

          </div>
        </t>
      </t>
    </template>
</odoo>